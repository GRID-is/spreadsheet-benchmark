<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shim for replay/spreadsheetgear.ts, which records the SpreadsheetGear version here as the
       engine version. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SpreadsheetGear" Version="9.3.85" />
  </ItemGroup>
</Project>
